# Copy to .env for local dev, and set the same values in Vercel
# (Project → Settings → Environment Variables) so the deployed site captures leads.

# Google Analytics 4 — optional, but needed for the ads conversion event
# (generate_lead fires only after a lead is actually saved).
VITE_GA_MEASUREMENT_ID=

# Supabase — stores pilot interest submissions.
# This anon key is a PUBLIC, INSERT-ONLY credential: RLS lets it write to
# pilot_interest but gives it no read access, so it cannot be used to pull leads
# back out. See supabase/migrations/0001_pilot_interest.sql.
VITE_SUPABASE_URL=https://cfwupjuzzcrmqjvzlbev.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNmd3VwanV6emNybXFqdnpsYmV2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI4MDY1OTIsImV4cCI6MjA5ODM4MjU5Mn0.WjDSBLO9iu-2UMJpBt3GPuhPEZaIrt55AZ_qI-vR4mU
